#: src/presentation/frontends/qtfrontend/frameview.cpp:305
#: src/presentation/frontends/qtfrontend/frameview.cpp:321
msgctxt "FrameView|"
msgid ""
"Grabbing failed. This may happen if you try\n"
"to grab from an invalid device. Please check\n"
"your grabber settings in the preferences menu."
msgstr ""
"No s'ha pogut fer la captura. Açò pot passar si intenteu\n"
"capturar des d'un dispositiu no vàlid. Comproveu\n"
"la configuració de la capturadora en el menú de preferències."

#: src/presentation/frontends/qtfrontend/frameview.cpp:331
msgctxt "FrameView|"
msgid ""
"You have to define an image grabber to use.\n"
"This can be set in the preferences menu."
msgstr ""
"Cal definir una capturadora d'imatges que s'utilitzarà.\n"
"Açò es pot fer en el menú de les preferències."

