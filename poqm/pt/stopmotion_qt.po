#: src/presentation/frontends/qtfrontend/framepreferencesmenu.cpp:106
msgctxt "FramePreferencesMenu|"
msgid ""
"<h4>Add sound</h4> <p>With this button you can <em>add sounds</em> to the "
"selected frame.</p> <p>The sound will begin playing when this frame is shown "
"and play until it is done.</p>"
msgstr ""
"<h4>Adicionar um som</h4> <p>Com este botão poderá <em>adicionar sons</em> à "
"imagem seleccionada.</p> <p>O som deverá começar a reproduzir quando chegar "
"a esta imagem e continuar até que termine.</p>"

#: src/presentation/frontends/qtfrontend/framepreferencesmenu.cpp:114
msgctxt "FramePreferencesMenu|"
msgid ""
"<h4>Remove sound</h4> <p>With this button you can <em>remove</em> the "
"selected sound from this frame.</p>"
msgstr ""
"<h4>Remover o som</h4> <p>Com este botão, poderá <em>remover</em> o som "
"seleccionado desta imagem.</p>"

#: src/presentation/frontends/qtfrontend/framepreferencesmenu.cpp:121
msgctxt "FramePreferencesMenu|"
msgid ""
"<h4>Change name</h4> <p>With this button you can change the name of the "
"selected sound. <BR>The name of the sound has no other effect than making it "
"easier work with the animation.</p>"
msgstr ""
"<h4>Mudar o nome</h4> <p>Com este botão poderá modificar o nome do som "
"seleccionado. <BR>O nome do som não tem qualquer efeito que não seja "
"simplificar o trabalho com a animação.</p>"

#: src/presentation/frontends/qtfrontend/framepreferencesmenu.cpp:129
msgctxt "FramePreferencesMenu|"
msgid ""
"<h4>Sounds</h4> <p>This list shows all the sounds connected to this frame.</"
"p><p>The sounds will begin playing when this frame is shown and play until "
"they are done.</p>"
msgstr ""
"<h4>Sons</h4> <p>Esta lista mostra todos os sons associados a esta imagem.</"
"p><p>Os sons irão iniciar a sua reprodução quando chegar a esta imagem e "
"prosseguir até que terminem.</p>"

