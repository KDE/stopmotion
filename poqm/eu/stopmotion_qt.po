msgstr "Hobespenen fitxategia ezin da irakurri"

#: src/presentation/frontends/qtfrontend/qtfrontend.cpp:383
#, qt-format
msgctxt "QtFrontend|"
msgid "Preferences file %1 is unreadable. Please correct this and try again."
msgstr ""
"Hobespenen %1 fitxategia irakurgaitza da. Mesedez, hori zuzendu eta berriz "
"saiatu."

#: src/presentation/frontends/qtfrontend/qtfrontend.cpp:388
#, qt-format
msgctxt "QtFrontend|"
msgid ""
"Preferences file %1 is not a valid XML preferences file. Please correct this "
"or delete the file and try again."
msgstr ""
"Hobespenen %1 fitxategia ez da hobespenen XML fitxategi balioduna. Mesedez "
"hori zuzendu eta fitxategia ezabatu eta berriz saiatu."

