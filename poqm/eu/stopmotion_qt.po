#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:558
msgctxt "MainWindowGUI|"
msgid "<h4>New</h4> <p>Creates a <em>new</em> project.</p>"
msgstr "<h4>Berria</h4>k <p>Proiektu <em>berria</em> sortzen du.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:563
msgctxt "MainWindowGUI|"
msgid "New project"
msgstr "Proiektu berria"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:567
msgctxt "MainWindowGUI|"
msgid "<h4>Open</h4> <p><em>Opens</em> a Stopmotion project file.</p>"
msgstr ""
"<h4>Ireki</h4>k <p>Stopmotion proiektu fitxategi bat <em>irekitzen</em> du.</"
"p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:571
msgctxt "MainWindowGUI|"
msgid "Open project"
msgstr "Ireki proiektua"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:575
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Save</h4> <p><em>Saves</em> the current animation as a Stopmotion "
"project file. <BR>If this project has been saved before it will "
"automatically be saved to the previously selected file.</p>"
msgstr ""
"<h4>Gorde</h4> <p>Uneko animazioa Stopmotion proiektu-fitxategi gisa "
"<em>gordetzen</em> du. <BR>Proiektu hau aurrez gorde bada, aurretik "
"aukeratutako fitxategian automatikoki gordeko da.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:581
msgctxt "MainWindowGUI|"
msgid "Save project"
msgstr "Gorde proiektua"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:585
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Save As</h4> <p><em>Saves</em> the current animation as a Stopmotion "
"project file.</p>"
msgstr ""
"<h4>Gorde Honela</h4> <p>Uneko animazioa Stopmotion proiektu fitxategi gisa "
"<em>Gordetzen</em> du.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:590
msgctxt "MainWindowGUI|"
msgid "Save project As"
msgstr "Gorde proiektua honela"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:594
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Video</h4> <p>Exports the current project as <em>video</em>.</p>You will "
"be given a wizard to guide you."
msgstr ""
"<h4>Bideoa</h4> <p>Uneko proiektua <em>bideo</em> gisa esportatzen du.</"
"p>Gidatuko zaituen morroi bat izango duzu."

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:601
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Cinerella</h4> <p>Exports the current animation as a <em>Cinerella</em> "
"project.</p>You will be given a wizard to guide you."
msgstr ""
"<h4>Cinerella</h4> <p>Uneko animazioa <em>Cinerella</em> proiektu gisa "
"esportatzen du.</p>Gidatuko zaituen morroi bat emango zaizu."

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:608
msgctxt "MainWindowGUI|"
msgid "<h4>Quit</h4> <p><em>Quits</em> the program.</p>"
msgstr "<h4>Irten</h4> <p>Programatik <em>Irtete</em>ko.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:612
msgctxt "MainWindowGUI|"
msgid "Quit"
msgstr "Irten"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:618
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Undo</h4> <p><em>Undoes</em> your last operation. You can press undo "
"several time to undo earlier operations.</p>"
msgstr ""
"<h4>Desegin</h4> <p>Zure azken eragiketa <em>desegiten</em> du. Desegin "
"hainbat aldiz saka dezakezu aurreragoko eragiketak desegiteko.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:623
msgctxt "MainWindowGUI|"
msgid "Undo"
msgstr "Desegin"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:627
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Redo</h4> <p><em>Redoes</em> your last operation. You can press redo "
"several times to redo several operations.</p>"
msgstr ""
"<h4>Berregin</h4> <p>Zure azken eragiketa <em>Berregiten</em> du. Berregin "
"hainbat aldiz saka dezakezu hainbat eragiketa berregiteko.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:632
msgctxt "MainWindowGUI|"
msgid "Redo"
msgstr "Berregin"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:636
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Cut</h4> <p><em>Cuts</em> the selected frames out of the animation and "
"adds them to the clipboard so that you can paste them in somewhere else.</p>"
msgstr ""
"<h4>Ebaki</h4> <p>Hautatutako fotogramak animaziotik <em>Ebakitzen</em> ditu "
"eta arbelera gehitzen ditu beste nonbait itsas ditzazun.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:641
msgctxt "MainWindowGUI|"
msgid "Cut"
msgstr "Ebaki"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:645
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Copy</h4> <p><em>Copies</em> the selected frames to the clipboard. You "
"can then paste them in another place.</p>"
msgstr ""
"<h4>Kopiatu</h4> <p>Hautatutako fotogramak arbelera <em>Kopiatzen</em> ditu. "
"Ondoren beste leku batean itsas ditzakezu.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:650
msgctxt "MainWindowGUI|"
msgid "Copy"
msgstr "Kopiatu"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:654
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Paste</h4> <p><em>Pastes</em> the frames which are currently in the "
"clipboard into the selected location.</p> <p>You can copy/cut images from "
"another programs and then use this option to paste them into this animation."
"</p>"
msgstr ""
"<h4>Itsatsi</h4> <p>Une horretan arbelean dauden fotogramak hautatutako "
"kokalekuan <em>Itsasten</em> ditu.</p> <p>Beste programa batzuetako irudiak "
"kopiatu/ebaki ditzakezu eta ondoren aukera hau erabil dezakezu haiek "
"animazio honetan itsasteko.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:660
msgctxt "MainWindowGUI|"
msgid "Paste"
msgstr "Itsatsi"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:664
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Go to frame</h4> <p>This will bring up a popup-menu at the bottom where "
"you can choose a frame you want to <em>go to</em>.</p>"
msgstr ""
"<h4>Joan fotogramara</h4> <p>Honek, behealdean, menu gainerakor bat agertuko "
"du, non <em>joan nahi duzun</em> fotograma bat aukeratu dezakezun.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:669
msgctxt "MainWindowGUI|"
msgid "Go to frame"
msgstr "Joan fotogramara"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:673
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Configure Stopmotion</h4> <p>This will open a window where you can "
"<em>configure</em> Stopmotion with various input and output devices.</p>"
msgstr ""
"<h4>Konfiguratu Stopmotion</h4> <p>Stopmotion hainbat sarrera eta irteera "
"gailurekin <em>konfiguratzeko</em> leiho bat irekiko du.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:678
msgctxt "MainWindowGUI|"
msgid "Configure Stopmotion"
msgstr "Konfiguratu Stopmotion"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:684
msgctxt "MainWindowGUI|"
msgid ""
"<h4>What's This</h4> <p>This will give you a WhatsThis mouse cursor which "
"can be used to bring up helpful information like this.</p>"
msgstr ""
"<h4>Zer da hau</h4> <p>Honen gisako informazio lagungarria ateratzeko "
"ZerDaHau sagu-kurtsore bat emango dizu.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:689
msgctxt "MainWindowGUI|"
msgid "What's This"
msgstr "Zer da hau"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:693
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Help</h4> <p>This button will bring up a dialog with the Stopmotion "
"manual</p>"
msgstr ""
"<h4>Laguntza</h4> <p>Honek Stopmotion-en eskuliburua duen elkarrizketa-"
"koadro bat aterako du.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:697
msgctxt "MainWindowGUI|"
msgid "Help"
msgstr "Laguntza"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:701
msgctxt "MainWindowGUI|"
msgid ""
"<h4>About</h4> <p>This will display a small information box where you can "
"read general information as well as the names of the developers behind this "
"excellent piece of software.</p>"
msgstr ""
"<h4>Honi buruz</h4> <p>Informazio-koadro txiki bat azalduko du, informazio "
"orokorra eta software pieza bikain honen atzean dauden garatzaileen izenak "
"irakurri ahal izango dituzu.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:707
msgctxt "MainWindowGUI|"
msgid "About"
msgstr "Honi buruz"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:713
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Frame number</h4><p>This area displays the number of the currently "
"selected frame</p>"
msgstr ""
"<h4>Fotograma kopurua</h4><p>Azalera honek une horretan hautatutako "
"fotogramaren zenbakia erakusten du.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:720
msgctxt "MainWindowGUI|"
msgid ""
"<h4>FrameView</h4><p> In this area you can see the selected frame. You can "
"also play animations in this window by pressing the <b>Play</b> button.</p>"
msgstr ""
"<h4>Fotograma-ikuspegia</h4><p>Azalera honetan hautatutako fotograma ikus "
"dezakezu. Leiho honetan <b>Jo</b> botoia sakatuz, animazioak ere jo "
"ditzakezu.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:727
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Go to frame menu</h4> <p>Here you can specify a framenumber and the "
"program will jump to the specified frame</p> "
msgstr ""
"<h4>Jo fotogramara menua</h4> <p>Hemen fotograma zenbaki bat zehaztu "
"dezakezu, eta programak zehaztutako fotogramara jauzi egingo du.</p> "

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:733
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Frame preferences menu</h4> <p>In this menu you can set preferences for "
"the selected frame/frames, such as <b>subtitles</b>, <b>sound effects</b>, "
"etc.</p>"
msgstr ""
"<h4>Fotograma hobespenen menua</h4> <p>Menu honetan hautatutako fotogramaren/"
"fotogramen hobespenak ezar ditzakezu, hala nola <b>azpidatziak</b>, <b>soinu "
"efektuak</b>, etab.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:740
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Tool menu</h4> <p>This is the tool menu where most of the buttons and "
"widgets you will need when working on stop motion animations are located.</p>"
msgstr ""
"<h4>Tresna menua</h4> <p>Hau da stop-motion animazioetan lanean ari zarenean "
"beharko dituzun botoi eta trepeta gehienak kokatuta dauden menua.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:746
msgctxt "MainWindowGUI|"
msgid ""
"<h4>FrameBar</h4> <p>In this area you can see the frames and scenes in the "
"animations and build the animation by moving the them around.</p><p>You can "
"switch to the next and the previous frame using the <b>arrow buttons</b> or "
"<b>x</b> and <b>z</b></p> "
msgstr ""
"<h4>Fotograma-barra</h4> <p>Azalera honetan animazioko fotogramak eta "
"eszenak ikus ditzakezu, eta haiek mugituz animazioa eraiki dezakezu.</"
"p><p>Hurrengo eta aurreko markora alda dezakezu <b>gezi botoiak</b> edo "
"<b>x</b> eta <b>z</b> erabiliz.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:760
msgctxt "MainWindowGUI|"
msgid "Unsaved changes"
msgstr "Gorde gabeko aldaketak"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:761
