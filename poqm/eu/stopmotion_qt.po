#: src/presentation/frontends/qtfrontend/qtfrontend.cpp:377
msgctxt "QtFrontend|"
msgid "Stopmotion cannot be started."
msgstr "Stopmotion ezin da abiarazi."

#: src/presentation/frontends/qtfrontend/qtfrontend.cpp:378
msgctxt "QtFrontend|"
msgid ""
"Failed to get exclusive lock on command.log. Perhaps Stopmotion is already "
"running."
msgstr ""
"«command.log» fitxategiaren giltzatze esklusibo bat lortzea huts egin du. "
"Agian Stopmotion jada martxan dago."

#: src/presentation/frontends/qtfrontend/qtfrontend.cpp:382
